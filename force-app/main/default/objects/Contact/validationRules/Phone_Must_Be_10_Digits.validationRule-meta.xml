<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Must_Be_10_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Phone)), NOT(REGEX(Phone, &quot;^[0-9]{10}$&quot;)))</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone must be exactly 10 digits</errorMessage>
</ValidationRule>
