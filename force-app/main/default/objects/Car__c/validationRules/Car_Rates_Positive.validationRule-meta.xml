<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Car_Rates_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Daily_Rate__c &lt;= 0,
Extra_KM_Rate__c &lt;= 0,
Free_KM_Per_Day__c &lt; 0)</errorConditionFormula>
    <errorMessage>Daily rate and extra km rate must be
greater than 0, and free km cannot be
negative.</errorMessage>
</ValidationRule>
