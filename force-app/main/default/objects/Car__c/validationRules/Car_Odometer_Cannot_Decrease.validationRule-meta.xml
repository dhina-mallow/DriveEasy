<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Car_Odometer_Cannot_Decrease</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()),
ISCHANGED(Current_Odometer__c),
Current_Odometer__c &lt;
PRIORVALUE(Current_Odometer__c))</errorConditionFormula>
    <errorMessage>The car odometer cannot go down.</errorMessage>
</ValidationRule>
